APP_NAME=StockFlow API
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./inventory.db
SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=stockflow-api
JWT_AUDIENCE=stockflow-clients
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
ENABLE_DOCS=true
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=1048576
POSTGRES_PASSWORD=replace-with-a-unique-database-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-grafana-password
OTEL_ENABLED=false
OTEL_SERVICE_NAME=stockflow-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORT_INTERVAL_MILLISECONDS=5000
OTEL_EXPORT_TIMEOUT_SECONDS=10
OTEL_TRACE_SAMPLE_RATIO=1.0
